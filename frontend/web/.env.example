# Base URL của backend API (bao gồm context-path).
# Dev server dùng proxy nên có thể để trống để gọi qua "/api/v1".
VITE_API_BASE_URL=/api/v1

# Base URL để dựng URL tuyệt đối cho ảnh upload.
# Để trống -> dùng `${VITE_API_BASE_URL}/uploads`.
# Ví dụ khi chạy backend ở máy khác: http://192.168.1.10:8080/api/v1/uploads
VITE_UPLOADS_BASE_URL=
